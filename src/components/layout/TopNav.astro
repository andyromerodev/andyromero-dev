---
import type { Lang, NavItem } from '../../i18n/ui';
import ThemeToggle from '../ui/ThemeToggle.astro';

interface Props {
  items: NavItem[];
  lang: Lang;
  langLabel: string;
  alternatePath: string;
}

const { items, lang, langLabel, alternatePath } = Astro.props;
const currentPath = Astro.url.pathname;

function isActive(href: string) {
  const normalized = href.replace(/\/$/, '') || '/';
  const current = currentPath.replace(/\/$/, '') || '/';
  return current === normalized;
}
---

<header class="sticky top-0 z-50 hidden bg-surface/85 backdrop-blur-md md:block">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-3">
    <a href={lang === 'en' ? '/en' : '/'} class="title-md flex items-center gap-2.5 text-on-surface">
      <span class="grid h-9 w-9 place-items-center rounded-[40%] bg-primary-container font-mono text-xs text-on-primary-container" aria-hidden="true">AR</span>
      Andy Romero
    </a>

    <nav aria-label="Navegación principal" class="flex items-center gap-1">
      {
        items.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'state-layer label-lg inline-flex h-10 items-center rounded-full px-4 transition-colors duration-200 ease-effects',
              isActive(item.href) ? 'bg-secondary-container text-on-secondary-container' : 'text-on-surface-variant',
            ]}
          >
            {item.label}
          </a>
        ))
      }

      <ThemeToggle class="ml-2" />

      <a
        href={alternatePath}
        class="state-layer label-lg ml-1 inline-flex h-10 items-center rounded-full border border-outline px-4 text-on-surface-variant"
        aria-label="Cambiar idioma"
      >
        {langLabel}
      </a>
    </nav>
  </div>
</header>
