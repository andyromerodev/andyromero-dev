---
import type { ProjectItem } from '../../i18n/ui';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
---

<article class="flex h-full flex-col justify-between gap-4 rounded-lg border border-border bg-surface p-5 transition-colors hover:border-border-accent">
  <div class="flex flex-col gap-2">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-mono text-sm font-medium text-text">{project.name}</h3>
      <span class="shrink-0 font-mono text-[11px] text-text-dim">{project.date}</span>
    </div>
    <p class="text-sm leading-relaxed text-text-muted">{project.summary}</p>
  </div>

  <div class="flex flex-col gap-3">
    <div class="flex flex-wrap gap-1.5">
      {project.tags.map((tag) => (
        <span class="rounded-full border border-border px-2 py-0.5 font-mono text-[11px] text-text-dim">{tag}</span>
      ))}
    </div>
    <a
      href={project.link.url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 font-mono text-xs text-accent-2 hover:text-accent"
    >
      {project.link.label}
      <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17 17 7M8 7h9v9" />
      </svg>
    </a>
  </div>
</article>
