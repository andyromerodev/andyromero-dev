---
import ThemeToggle from '../ui/ThemeToggle.astro';

interface Props {
  alternatePath: string;
  langLabel: string;
}

const { alternatePath, langLabel } = Astro.props;
---

<div class="fixed right-4 top-4 z-50 flex items-center gap-1 rounded-full bg-surface-container-high p-1 shadow-sm md:hidden">
  <ThemeToggle />
  <a
    href={alternatePath}
    aria-label="Cambiar idioma"
    class="state-layer label-lg inline-flex h-10 items-center rounded-full px-4 text-on-surface-variant"
  >
    {langLabel}
  </a>
</div>
