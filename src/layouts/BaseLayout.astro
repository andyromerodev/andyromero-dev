---
import '../styles/global.css';
import TopNav from '../components/layout/TopNav.astro';
import BottomNav from '../components/layout/BottomNav.astro';
import MobileLangSwitch from '../components/layout/MobileLangSwitch.astro';
import Footer from '../components/layout/Footer.astro';
import { getLangFromUrl, useTranslations, getAlternatePath } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  /** Error pages: keep out of search results and skip canonical/alternate links. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const alternatePath = getAlternatePath(Astro.url, lang);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title ? `${title} · ${t.site.title}` : t.site.title;
const pageDescription = description ?? t.site.description;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = stored ?? (prefersDark ? 'dark' : 'light');
      })();
    </script>
    <meta name="theme-color" content="#f6fbf4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1511" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    {!noindex && <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es'} href={new URL(alternatePath, Astro.site)} />}

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-screen bg-surface font-sans text-on-surface">
    <TopNav items={t.nav} lang={lang} langLabel={t.langSwitch.label} alternatePath={alternatePath} />
    <MobileLangSwitch alternatePath={alternatePath} langLabel={t.langSwitch.label} />

    <main class="pb-24 md:pb-0">
      <slot />
    </main>

    <Footer builtWith={t.footer.builtWith} rights={t.footer.rights} />
    <BottomNav items={t.nav} />
  </body>
</html>
