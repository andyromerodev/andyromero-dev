---
interface Props {
  alternatePath: string;
  langLabel: string;
}

const { alternatePath, langLabel } = Astro.props;
---

<a
  href={alternatePath}
  aria-label="Cambiar idioma"
  class="fixed right-4 top-4 z-50 rounded-md border border-border bg-bg/90 px-2.5 py-1.5 font-mono text-xs text-text-muted backdrop-blur transition-colors hover:border-border-accent hover:text-accent md:hidden"
>
  {langLabel}
</a>
