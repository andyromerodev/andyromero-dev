---
import type { UiContent } from '../../i18n/ui';
import { socialLinks } from '../../i18n/ui';
import Button from '../../components/ui/Button.astro';

interface Props {
  t: UiContent;
}

const { t } = Astro.props;
const { contact, hero } = t;

const links = [
  { label: 'Email', value: socialLinks.email, href: `mailto:${socialLinks.email}` },
  { label: 'GitHub', value: 'github.com/andyromerodev', href: socialLinks.github },
  { label: 'LinkedIn', value: 'linkedin.com/in/andyromerodev', href: socialLinks.linkedin },
  { label: 'Stack Overflow', value: 'stackoverflow.com/users/5708478/andy-romero', href: socialLinks.stackoverflow },
];
---

<section class="mx-auto flex max-w-2xl flex-col gap-8 px-4 pb-14 pt-20 sm:px-6 md:py-20">
  <div class="flex flex-col gap-3">
    <h1 class="label-lg text-primary">{contact.eyebrow}</h1>
    <h2 class="headline-md text-on-surface">{contact.title}</h2>
    <p class="body-lg max-w-xl text-on-surface-variant">{contact.intro}</p>
  </div>

  <div class="flex flex-col gap-5 rounded-2xl bg-primary-container p-6 sm:p-8">
    <dl class="flex flex-col gap-4 text-on-primary-container">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-3">
        <dt class="label-md w-32 shrink-0 opacity-80">{contact.locationLabel}</dt>
        <dd class="body-lg">{hero.location}</dd>
      </div>
      <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-3">
        <dt class="label-md w-32 shrink-0 opacity-80">{contact.emailLabel}</dt>
        <dd class="body-lg break-all">{socialLinks.email}</dd>
      </div>
    </dl>
    <Button href={`mailto:${socialLinks.email}`} class="w-fit">{contact.emailLabel}</Button>
  </div>

  <div class="flex flex-col gap-3">
    <p class="label-lg text-primary">{contact.linksTitle}</p>
    <div class="flex flex-col gap-1 rounded-xl bg-surface-container-low p-2">
      {
        links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('mailto:') ? undefined : '_blank'}
            rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
            class="state-layer flex flex-col gap-0.5 rounded-lg px-4 py-3 text-on-surface sm:flex-row sm:items-center sm:justify-between"
          >
            <span class="title-md">{link.label}</span>
            <span class="truncate font-mono text-xs text-on-surface-variant">{link.value}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
