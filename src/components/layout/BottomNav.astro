---
import type { NavItem } from '../../i18n/ui';

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
const currentPath = Astro.url.pathname;

function isActive(href: string) {
  const normalized = href.replace(/\/$/, '') || '/';
  const current = currentPath.replace(/\/$/, '') || '/';
  return current === normalized;
}
---

<nav
  class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-5 bg-surface-container pb-[env(safe-area-inset-bottom)] md:hidden"
  aria-label="Navegación principal"
>
  {
    items.map((item) => {
      const active = isActive(item.href);
      return (
        <a
          href={item.href}
          aria-current={active ? 'page' : undefined}
          class:list={[
            'group label-md flex min-h-20 flex-col items-center justify-center gap-1 px-1 py-3 transition-colors',
            active ? 'text-on-surface' : 'text-on-surface-variant',
          ]}
        >
          <span
            class:list={[
              'grid h-8 place-items-center rounded-full transition-[width,background-color] duration-350 ease-spatial',
              active ? 'w-16 bg-secondary-container text-on-secondary-container' : 'w-8 group-active:w-16 group-active:bg-on-surface/10',
            ]}
          >
            {item.icon === 'home' && (
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V10Z" />
              </svg>
            )}
            {item.icon === 'about' && (
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21c0-4 4-6 8-6s8 2 8 6" />
              </svg>
            )}
            {item.icon === 'projects' && (
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 7a1 1 0 0 1 1-1h5l2 2h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7Z" />
              </svg>
            )}
            {item.icon === 'skills' && (
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m8 9-4 3 4 3M16 9l4 3-4 3M13 6l-2 12" />
              </svg>
            )}
            {item.icon === 'contact' && (
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3.5 6.5h17v11h-17z" />
                <path d="m4 7 8 6 8-6" />
              </svg>
            )}
          </span>
          <span>{item.label}</span>
        </a>
      );
    })
  }
</nav>
