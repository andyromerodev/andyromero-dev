---
import type { UiContent } from '../../i18n/ui';

interface Props {
  t: UiContent;
}

const { t } = Astro.props;
const { about } = t;
---

<section class="mx-auto flex max-w-3xl flex-col gap-14 px-4 pb-14 pt-20 sm:px-6 md:py-20">
  <div class="flex flex-col gap-4">
    <h1 class="label-lg text-primary">{about.eyebrow}</h1>
    <div class="rounded-2xl bg-primary-container p-6 sm:p-8">
      <p class="body-lg text-on-primary-container">{about.profile}</p>
    </div>
  </div>

  <div class="flex flex-col gap-6">
    <h2 class="headline-md text-on-surface">{about.experienceTitle}</h2>
    <ol class="flex flex-col gap-8 border-l-2 border-outline-variant pl-6">
      {
        about.experience.map((item) => (
          <li class="relative">
            <span class="absolute -left-[33px] top-1 h-4 w-4 rounded-full border-4 border-surface bg-primary" />
            <div class="flex flex-col gap-1.5">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <p class="title-md text-on-surface">
                  {item.position} <span class="text-outline">·</span> {item.company}
                </p>
                <p class="font-mono text-xs text-on-surface-variant">{item.period}</p>
              </div>
              <p class="label-md text-on-surface-variant">{item.location}</p>
              {item.summary && <p class="body-md text-on-surface-variant">{item.summary}</p>}
              {item.highlights.length > 0 && (
                <ul class="mt-1 flex flex-col gap-1">
                  {item.highlights.map((h) => (
                    <li class="body-md flex gap-2.5 text-on-surface-variant">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary/60" />
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              )}
              {item.link && (
                <a
                  href={item.link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="state-layer label-lg -ml-3 mt-1 inline-flex h-10 w-fit items-center gap-1.5 rounded-full px-3 text-primary"
                >
                  {item.link.label}
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17 17 7M8 7h9v9" />
                  </svg>
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="flex flex-col gap-6">
    <h2 class="headline-md text-on-surface">{about.educationTitle}</h2>
    {
      about.education.map((edu) => (
        <div class="flex flex-col gap-1.5 rounded-xl bg-surface-container-low p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <p class="title-md text-on-surface">{edu.institution}</p>
            <p class="font-mono text-xs text-on-surface-variant">{edu.period}</p>
          </div>
          <p class="body-md text-on-surface-variant">{edu.degree} — {edu.location}</p>
          <ul class="mt-1 flex flex-col gap-1">
            {edu.highlights.map((h) => (
              <li class="body-md flex gap-2.5 text-on-surface-variant">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary/60" />
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="flex flex-col gap-6">
    <h2 class="headline-md text-on-surface">{about.additionalTrainingTitle}</h2>
    <div class="flex flex-col gap-1.5 rounded-xl bg-surface-container-low p-6">
      <p class="title-md text-on-surface">{about.additionalTraining.name}</p>
      <p class="body-md text-on-surface-variant">{about.additionalTraining.location}</p>
      <ul class="mt-1 flex flex-col gap-1">
        {about.additionalTraining.highlights.map((h) => (
          <li class="body-md flex gap-2.5 text-on-surface-variant">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary/60" />
            <span>{h}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="flex flex-col gap-6">
    <h2 class="headline-md text-on-surface">{about.languagesTitle}</h2>
    <div class="flex flex-col gap-3 sm:flex-row">
      {
        about.languages.map((l) => (
          <div class="flex-1 rounded-xl bg-secondary-container p-5">
            <p class="title-md text-on-secondary-container">{l.label}</p>
            <p class="body-md text-on-secondary-container/80">{l.details}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
